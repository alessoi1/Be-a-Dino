--!strict
-- Server entry point. Starts the services and checks the config (log on errors).
-- Only checkable in Roblox Studio.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Log = require(Shared:WaitForChild("Log"))
local Movement = require(Shared:WaitForChild("Config"):WaitForChild("Movement"))

local RejectLimiter = require(script.Parent:WaitForChild("RejectLimiter"))
local ServerClock = require(script.Parent:WaitForChild("ServerClock"))
local PlayerState = require(script.Parent:WaitForChild("PlayerState"))
local DataService = require(script.Parent:WaitForChild("DataService"))
local CollectionService = require(script.Parent:WaitForChild("CollectionService"))
local AutoFarmService = require(script.Parent:WaitForChild("AutoFarmService"))
local BountyService = require(script.Parent:WaitForChild("BountyService"))
local CoinService = require(script.Parent:WaitForChild("CoinService"))
local QuestService = require(script.Parent:WaitForChild("QuestService"))
local DeathService = require(script.Parent:WaitForChild("DeathService"))
local ReceiptService = require(script.Parent:WaitForChild("ReceiptService"))
local VariantService = require(script.Parent:WaitForChild("VariantService"))
local EggService = require(script.Parent:WaitForChild("EggService"))
local ComboService = require(script.Parent:WaitForChild("ComboService"))
local FrenzyService = require(script.Parent:WaitForChild("FrenzyService"))
local OfferService = require(script.Parent:WaitForChild("OfferService"))
local DailyRewardService = require(script.Parent:WaitForChild("DailyRewardService"))
local ArenaService = require(script.Parent:WaitForChild("ArenaService"))
local LobbyService = require(script.Parent:WaitForChild("LobbyService"))
local MovementService = require(script.Parent:WaitForChild("MovementService"))
local AppearanceService = require(script.Parent:WaitForChild("AppearanceService"))
local LeaderboardService = require(script.Parent:WaitForChild("LeaderboardService"))
local PlayerCollision = require(script.Parent:WaitForChild("PlayerCollision"))
local StatsService = require(script.Parent:WaitForChild("StatsService"))
local BotService = require(script.Parent:WaitForChild("BotService"))
local EatingService = require(script.Parent:WaitForChild("EatingService"))
local FoodService = require(script.Parent:WaitForChild("FoodService"))
local DebugService = require(script.Parent:WaitForChild("DebugService"))

local log = Log.new("Main")
log.info("server started")

local limiter = RejectLimiter.new(Log.new("Remotes"), Movement.rejectLogIntervalSeconds, ServerClock.now)

-- PlayerState first: it must know a player before the other services react to them.
PlayerState.start()
DataService.start()
OfferService.start()
CollectionService.start()
CoinService.start()
QuestService.start(limiter)
StatsService.start()
ComboService.start()
FrenzyService.start()
BountyService.start()
DeathService.start(limiter)
AutoFarmService.start(limiter)
ArenaService.start()
AppearanceService.start()
ReceiptService.start()
VariantService.start(limiter)
EggService.start(limiter)
DailyRewardService.start(limiter)
MovementService.start(limiter)
LobbyService.start(limiter)
DeathService.setReviveHandler(LobbyService.revive)
LeaderboardService.start()
FoodService.start()
PlayerCollision.start()
BotService.start()
EatingService.start()
DebugService.start(limiter)
